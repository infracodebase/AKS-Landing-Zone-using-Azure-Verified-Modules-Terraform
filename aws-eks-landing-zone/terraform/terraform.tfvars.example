# AWS EKS Landing Zone - Terraform Variables Example
# Copy this file to terraform.tfvars and customize for your environment

# Environment and naming
environment  = "dev"
cluster_name = "eks-cluster"
aws_region   = "us-east-1"

# VPC Configuration
vpc_cidr               = "10.0.0.0/16"
private_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
public_subnet_cidrs    = ["10.0.10.0/24", "10.0.11.0/24"]
endpoints_subnet_cidrs = ["10.0.20.0/24", "10.0.21.0/24"]

# EKS Cluster Configuration
kubernetes_version      = "1.31"
enable_private_endpoint = true
enable_public_endpoint  = false
public_access_cidrs     = ["0.0.0.0/0"]

# System Node Group Configuration
system_node_instance_types = ["t3.medium"]
system_node_min_size       = 1
system_node_max_size       = 3
system_node_desired_size   = 2

# User Node Group Configuration
user_node_instance_types = ["m5.large"]
user_node_min_size       = 2
user_node_max_size       = 10
user_node_desired_size   = 3

# Storage Configuration
node_disk_size = 100

# ECR Configuration
enable_image_scanning   = true
image_tag_mutability   = "MUTABLE"
lifecycle_policy_days  = 7

# Monitoring Configuration
log_retention_days        = 30
enable_container_insights = true

# Add-ons Configuration
enable_aws_load_balancer_controller = true
enable_cluster_autoscaler          = true
enable_ebs_csi_driver              = true
enable_efs_csi_driver              = false

# Security Configuration
enable_vpc_flow_logs       = true
vpc_flow_logs_retention    = 30
enable_kms_encryption      = true

# Additional Tags
additional_tags = {
  Owner       = "Platform Team"
  CostCenter  = "Engineering"
  Project     = "EKS Landing Zone"
  Contact     = "platform-team@company.com"
  Purpose     = "Container Platform"
  Compliance  = "SOC2"
}